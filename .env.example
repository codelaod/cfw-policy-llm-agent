# 唯一外部配置模板。复制为 .env.local 后填写，勿在本示例写真实值。
# 启动/检查：bash scripts/e0.sh server --env-file .env.local [--config-check]
# 优先级：进程存在值（包括空） > 指定文件 > 程序默认值。
# 不执行 shell/变量展开；支持单/双引号、export、注释、BOM、CRLF。
# 文件内路径相对本文件目录；云凭据整组选择进程或文件，禁止跨来源补齐。

# 应用：口令至少16字符；前端仅在访问时输入口令，云/模型凭据只留后端。
CFW_APP_TOKEN=
CFW_DB_PATH=data/private/e0.sqlite
CFW_WEB_DIR=web/dist

# 模型：启用前填地址/密钥/原模型名；地址保留 /v1 等路径，不填 /chat/completions。
# provider profile 选 openai-compatible 或 minimax；当前可执行非流式 chat_completions。
CFW_MODEL_ENABLED=false
CFW_MODEL_BASE_URL=
CFW_MODEL_API_KEY=
CFW_MODEL_NAME=
CFW_MODEL_API_STYLE=chat_completions
CFW_MODEL_PROVIDER_PROFILE=openai-compatible
CFW_MODEL_TIMEOUT_SECONDS=30
CFW_MODEL_MAX_HTTP_ATTEMPTS=4
CFW_MODEL_MAX_OUTPUT_TOKENS=512

# 阿里云：启用前填期望账号和只读凭据，选择实际地域。
# 云 API 地址由 control plane / allowed regions 固定映射，不需要填写云 URL。
# env_ak 填 AK ID/Secret；env_sts 还需 Token，可填写已知凭据到期 RFC3339 时间。
# 进程里任一 CFW_ALIYUN_* 凭据存在，就必须在进程里提供该模式的整组凭据。
CFW_CLOUD_ENABLED=false
CFW_CLOUD_CONNECTION_REF=configured-aliyun
CFW_CLOUD_CREDENTIAL_MODE=env_ak
CFW_ALIYUN_ACCESS_KEY_ID=
CFW_ALIYUN_ACCESS_KEY_SECRET=
CFW_ALIYUN_SECURITY_TOKEN=
CFW_CLOUD_CREDENTIAL_EXPIRES_AT=
CFW_CLOUD_EXPECTED_ACCOUNT_ID=
CFW_CLOUD_CONTROL_PLANE_REGION=cn-hangzhou
CFW_CLOUD_ALLOWED_REGIONS='["cn-hangzhou"]'
CFW_CLOUD_ALLOWED_BOUNDARIES='["internet/in","internet/out","nat/out"]'
# 以下两个 JSON 数组仅额外收紧权限；空数组按上面的账号/地域/边界限权，任务仍需明确对象。
# assets 格式 [{"region":"cn-hangzhou","instance_id":"i-..."}]
# gateways 格式 [{"region":"cn-hangzhou","id":"ngw-..."}]
CFW_CLOUD_ALLOWED_ASSETS='[]'
CFW_CLOUD_ALLOWED_NAT_GATEWAYS='[]'
CFW_CLOUD_TIMEOUT_SECONDS=30
CFW_CLOUD_MAX_HTTP_ATTEMPTS=100

# 云/模型只有这一份共享预算；填稳定的授权周期名，次数是累计物理请求上限。
# 空 ref 和全0表示未配置授权；明确0禁止请求。文件填写或检查不会发请求。
# 到期可留空或填 RFC3339。已有持久授权的增额/续期须显式 --budget-change，不因改文件清账。
CFW_BUDGET_REF=
CFW_BUDGET_EXPIRES_AT=
CFW_BUDGET_APPLICATION_CLOUD_ATTEMPTS=0
CFW_BUDGET_SESSION_CLOUD_ATTEMPTS=0
CFW_BUDGET_APPLICATION_MODEL_ATTEMPTS=0
CFW_BUDGET_SESSION_MODEL_ATTEMPTS=0

# 数据时效：0表示不复用；仍检查来源/完整性/关联等资格。这些默认值尚待真实环境校准。
CFW_FRESHNESS_VERSION=local-freshness-v1
CFW_FRESHNESS_CONFIGURATION_MAX_AGE_SECONDS=900
CFW_FRESHNESS_METADATA_MAX_AGE_SECONDS=3600

# 执行保护：以下一般保留默认值即可，可同名环境覆盖。0不会自动变成默认值。
# 单任务上限和上面共享累计预算分别取严；不是服务商 SLA 或额外调用授权。
CFW_WORKLOAD_PROFILE_REF=local-workload-v1

# audit
CFW_WORKLOAD_AUDIT_QUEUE_SECONDS=120
CFW_WORKLOAD_AUDIT_EXECUTION_SECONDS=240
CFW_WORKLOAD_AUDIT_COLLECTION_SECONDS=90
CFW_WORKLOAD_AUDIT_RULES_SECONDS=20
CFW_WORKLOAD_AUDIT_MODEL_SECONDS=120
CFW_WORKLOAD_AUDIT_FINALIZE_SECONDS=10
CFW_WORKLOAD_AUDIT_MODEL_REQUEST_SECONDS=30
CFW_WORKLOAD_AUDIT_MODEL_LOGICAL_CALLS=6
CFW_WORKLOAD_AUDIT_MODEL_HTTP_ATTEMPTS=6
CFW_WORKLOAD_AUDIT_TOOL_CALLS=12
CFW_WORKLOAD_AUDIT_TOOL_BATCH=4
CFW_WORKLOAD_AUDIT_CLOUD_HTTP_ATTEMPTS=100
CFW_WORKLOAD_AUDIT_ASSETS_PER_BATCH=50
CFW_WORKLOAD_AUDIT_MAX_POLICIES=1000
CFW_WORKLOAD_AUDIT_MAX_QUERY_CELLS=50000

# assistant_turn
CFW_WORKLOAD_ASSISTANT_TURN_QUEUE_SECONDS=60
CFW_WORKLOAD_ASSISTANT_TURN_EXECUTION_SECONDS=90
CFW_WORKLOAD_ASSISTANT_TURN_COLLECTION_SECONDS=0
CFW_WORKLOAD_ASSISTANT_TURN_RULES_SECONDS=0
CFW_WORKLOAD_ASSISTANT_TURN_MODEL_SECONDS=80
CFW_WORKLOAD_ASSISTANT_TURN_FINALIZE_SECONDS=10
CFW_WORKLOAD_ASSISTANT_TURN_MODEL_REQUEST_SECONDS=30
CFW_WORKLOAD_ASSISTANT_TURN_MODEL_LOGICAL_CALLS=4
CFW_WORKLOAD_ASSISTANT_TURN_MODEL_HTTP_ATTEMPTS=4
CFW_WORKLOAD_ASSISTANT_TURN_TOOL_CALLS=8
CFW_WORKLOAD_ASSISTANT_TURN_TOOL_BATCH=4
CFW_WORKLOAD_ASSISTANT_TURN_CLOUD_HTTP_ATTEMPTS=0
CFW_WORKLOAD_ASSISTANT_TURN_ASSETS_PER_BATCH=50
CFW_WORKLOAD_ASSISTANT_TURN_MAX_POLICIES=1000
CFW_WORKLOAD_ASSISTANT_TURN_MAX_QUERY_CELLS=50000

# collect
CFW_WORKLOAD_COLLECT_QUEUE_SECONDS=120
CFW_WORKLOAD_COLLECT_EXECUTION_SECONDS=90
CFW_WORKLOAD_COLLECT_COLLECTION_SECONDS=80
CFW_WORKLOAD_COLLECT_RULES_SECONDS=0
CFW_WORKLOAD_COLLECT_MODEL_SECONDS=0
CFW_WORKLOAD_COLLECT_FINALIZE_SECONDS=10
CFW_WORKLOAD_COLLECT_MODEL_REQUEST_SECONDS=0
CFW_WORKLOAD_COLLECT_MODEL_LOGICAL_CALLS=0
CFW_WORKLOAD_COLLECT_MODEL_HTTP_ATTEMPTS=0
CFW_WORKLOAD_COLLECT_TOOL_CALLS=0
CFW_WORKLOAD_COLLECT_TOOL_BATCH=0
CFW_WORKLOAD_COLLECT_CLOUD_HTTP_ATTEMPTS=100
CFW_WORKLOAD_COLLECT_ASSETS_PER_BATCH=50
CFW_WORKLOAD_COLLECT_MAX_POLICIES=1000
CFW_WORKLOAD_COLLECT_MAX_QUERY_CELLS=0

# connection_check
CFW_WORKLOAD_CONNECTION_CHECK_QUEUE_SECONDS=60
CFW_WORKLOAD_CONNECTION_CHECK_EXECUTION_SECONDS=30
CFW_WORKLOAD_CONNECTION_CHECK_COLLECTION_SECONDS=20
CFW_WORKLOAD_CONNECTION_CHECK_RULES_SECONDS=0
CFW_WORKLOAD_CONNECTION_CHECK_MODEL_SECONDS=0
CFW_WORKLOAD_CONNECTION_CHECK_FINALIZE_SECONDS=10
CFW_WORKLOAD_CONNECTION_CHECK_MODEL_REQUEST_SECONDS=0
CFW_WORKLOAD_CONNECTION_CHECK_MODEL_LOGICAL_CALLS=0
CFW_WORKLOAD_CONNECTION_CHECK_MODEL_HTTP_ATTEMPTS=0
CFW_WORKLOAD_CONNECTION_CHECK_TOOL_CALLS=0
CFW_WORKLOAD_CONNECTION_CHECK_TOOL_BATCH=0
CFW_WORKLOAD_CONNECTION_CHECK_CLOUD_HTTP_ATTEMPTS=6
CFW_WORKLOAD_CONNECTION_CHECK_ASSETS_PER_BATCH=0
CFW_WORKLOAD_CONNECTION_CHECK_MAX_POLICIES=0
CFW_WORKLOAD_CONNECTION_CHECK_MAX_QUERY_CELLS=0
