# 复制为仓库根目录 .env.local 后填写；不要在 .env.example 中写真实密钥。
# .env.local 已被 Git 忽略；填写配置不等于授权调用付费服务。
# 使用服务商提供的 Base URL，保留必要路径（例如 /v1），不要填完整 /chat/completions。
CFW_MODEL_BASE_URL=https://your-model-provider.example/v1
CFW_MODEL_API_KEY=
CFW_MODEL_NAME=

# 仅登记计划使用的接口：chat_completions 或 responses，不代表真实适配已经完成。
CFW_MODEL_API_STYLE=chat_completions

# 未来真实验证的保护参数。它们不是金额上限，当前 config-check 不发送任何请求。
CFW_MODEL_TIMEOUT_SECONDS=30
CFW_MODEL_MAX_CALLS=4
CFW_MODEL_MAX_OUTPUT_TOKENS=512
