{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent offline audit and E0 task event v1",
  "description": "Persisted schema_version=1 events. SSE id is seq, event is type, data is this complete JSON object. The complete UTF-8 JSON event is bounded to 4096 bytes by storage. E3 tool payloads come from the app sink after actual Runner callbacks; no credential, raw tool response, reasoning, or model token stream belongs here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "seq",
    "type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^(e0|job)_[a-f0-9]{32}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "enum": [
        "job_status",
        "stage_changed",
        "tool_started",
        "tool_finished",
        "findings_available",
        "message_available",
        "report_available",
        "job_terminal"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "jobStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "queued",
            "running",
            "cancelling"
          ]
        },
        "phase": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "message_ref": {
          "type": "string",
          "pattern": "^message_[a-f0-9]{32}$"
        },
        "source": {
          "const": "synthetic"
        }
      }
    },
    "stagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "phase": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "source": {
          "const": "synthetic"
        },
        "summary": {
          "type": "string",
          "maxLength": 2048
        },
        "agent_result_ref": {
          "type": "string",
          "pattern": "^agent_result_[a-f0-9]{32}$"
        }
      }
    },
    "toolPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "tool",
        "call_id",
        "status",
        "elapsed_ms",
        "evidence_refs"
      ],
      "properties": {
        "phase": {
          "const": "L3"
        },
        "tool": {
          "enum": [
            "get_partition_context",
            "get_asset_context",
            "get_nat_association",
            "get_security_group_rules",
            "get_business_intent",
            "get_policy",
            "resolve_reference",
            "get_finding_evidence",
            "get_rule_definition"
          ]
        },
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "cancelled",
            "truncated",
            "rejected"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_refs": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "findingsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ref"
      ],
      "properties": {
        "result_ref": {
          "type": "string",
          "pattern": "^audit_[a-f0-9]{32}$"
        },
        "phase": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "is_final": {
          "const": false
        }
      }
    },
    "messagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_ref"
      ],
      "properties": {
        "message_ref": {
          "type": "string",
          "pattern": "^message_[a-f0-9]{32}$"
        },
        "phase": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "complete_message": {
          "const": true
        }
      }
    },
    "reportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_ref"
      ],
      "properties": {
        "report_ref": {
          "type": "string",
          "pattern": "^report_[a-f0-9]{32}$"
        },
        "phase": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        }
      }
    },
    "terminalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "phase": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "error_code": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[A-Z0-9_]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "job_status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/jobStatusPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stage_changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/stagePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              {
                "$ref": "#/$defs/toolPayload"
              },
              {
                "properties": {
                  "status": {
                    "const": "started"
                  },
                  "elapsed_ms": {
                    "const": 0
                  },
                  "evidence_refs": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              {
                "$ref": "#/$defs/toolPayload"
              },
              {
                "properties": {
                  "status": {
                    "enum": [
                      "succeeded",
                      "failed",
                      "cancelled",
                      "truncated",
                      "rejected"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "findings_available"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/findingsPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message_available"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/messagePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "report_available"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reportPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "job_terminal"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminalPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_id": {
            "pattern": "^e0_"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "job_status",
              "stage_changed",
              "job_terminal"
            ]
          }
        }
      }
    }
  ]
}
